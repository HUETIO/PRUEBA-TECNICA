# Referencia únicamente. `make up` genera un .env efímero y aleatorio.
# No copies estas variables con valores de ejemplo a un entorno compartido.
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=bia_datos
PG_SUPERUSER=postgres
PG_SUPERPASSWORD=<generado-localmente>

# Credenciales efímeras SOLO para evaluación local.
PG_INGEST_USER=rol_ingesta
PG_INGEST_PASSWORD=<generado-localmente>
PG_ANALYST_USER=rol_analista
PG_ANALYST_PASSWORD=<generado-localmente>
PG_AUDITOR_USER=rol_auditor
PG_AUDITOR_PASSWORD=<generado-localmente>
APP_ENCRYPTION_KEY=<generada-localmente>

KAFKA_BOOTSTRAP=localhost:9092
KAFKA_TOPIC=mediciones.raw
